    },
    {
      "id": "claim_63da180b570e4b48abd21a493527187e",
      "statement": "PostgresStore.ClaimNextExecution atomically claims the oldest pending execution using SELECT ... FOR UPDATE SKIP LOCKED inside a transaction, transitioning it to running, so concurrent workers never race for the same row and do not block on unrelated pending rows.",
