    {
      "id": "claim_c11d415505bc4b4c9c76ceb94bb1b41e",
      "statement": "worker.Pool runs one goroutine per configured concurrency that loops calling store.ClaimNextExecution and, when nothing is pending, blocks on a notify channel or a poll-interval ticker, so a missed Notify or an externally inserted row is still picked up on the next poll.",
      "evidence": [
        {
          "resource": "repo://internal/worker/pool.go#L93-L124",
