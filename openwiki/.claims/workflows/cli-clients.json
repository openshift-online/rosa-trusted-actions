    {
      "id": "claim_44a25fc3afe748b88ee8cb46e9470672",
      "statement": "rta (cmd/rta, implemented in internal/rta) is the production HTTP client for the Trusted Actions API, while action-cli and test-client are developer/test tooling: action-cli drives the executor pipeline directly without HTTP, and test-client is a thin HTTP client for exercising a running server.",
      "evidence": [
        {
          "resource": "repo://cmd/action-cli/main.go",
          "version": "repo-file-v1:sha256:c18a9afb0c37bcb31d67b068859f23e2a81c813df4ac6748f651b769751c23ef"
        },
        {
