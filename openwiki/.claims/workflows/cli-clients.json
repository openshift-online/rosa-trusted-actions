        }
      ]
    },
    {
      "id": "claim_8143bc272bd74fd29b990038d68fc4ae",
      "statement": "action-cli wires the full executor pipeline (authorization, audit logging, backplane/AWS client, action execution) directly against a kubeconfig or AWS static provider, bypassing the HTTP server entirely, to verify an action end-to-end.",
