    {
      "id": "claim_3420d26d65414cc4828c93fb7c8ed709",
      "statement": "action-cli enforces the same authorization rules as the server: namespace allowlisting (defaulting to --namespace), rejecting requests missing both --namespace and --cluster-scoped, and deny-by-default for secrets unless allowlisted via --allowed-secrets.",
