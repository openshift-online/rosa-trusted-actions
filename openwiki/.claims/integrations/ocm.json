        }
      ]
    },
    {
      "id": "claim_369dd22a22c34499b3cf4138634dc145",
      "statement": "cmd/server/main.go builds the OCM client's static Config from cfg.OCMBaseURL/OCMClientID/OCMClientSecret/OCMToken under the 'enabled' AuthPolicy, or from a loaded ocm-cli config file (ocmconfig.Load) under the 'ocmconfig' policy, and requires a non-empty, fully-populated []config.RoleMapping list under either policy, failing fatally at startup otherwise.",
