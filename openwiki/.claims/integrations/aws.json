    },
    {
      "id": "claim_db7f6266aca044e094abbbb44cd8ed5f",
      "statement": "buildClients is a single shared switch statement used by both StaticProvider and CloudCredentialsProvider to turn a requested []Service list and one aws.Config into a populated Clients struct, ensuring a new Service added to the enum cannot be silently unimplemented by one provider.",
      "evidence": [
        {
          "resource": "repo://internal/awsapi/awsapi.go#L118-L141",
          "version": "repo-lines-v1:sha256:6dd70841dd096e5b9aab4ceecd8d886e628469b017a385760cc5138e43bf9da0:"
