        }
      ]
    },
    {
      "id": "claim_78a7688e6ff54668aa5dbc1b1a505ebd",
      "statement": "AWSWriteAction adds Operation() and Resource() to AWSAction: Operation names the mutation checked against the server's write allowlist, and Resource fixes the object kind acted on; both come from the action itself, never from the caller's request, so a caller cannot relabel a terminate as a reboot or override what resource is mutated.",
      "evidence": [
        {
          "resource": "repo://internal/actions/actions.go#L99-L123",
          "version": "repo-lines-v1:sha256:87352c852a0e645446a4e4e31fc8f3047e86cd2fcd7f0ead8f7e494caf570f59:"
        },
        {
