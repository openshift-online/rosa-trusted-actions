        }
      ]
    },
    {
      "id": "claim_cb00dda5cb324963a725ff95b58dc8c4",
      "statement": "aws_cloudtrail.go's lookupCloudTrailEvents bounds every CloudTrail lookup to a time window: it defaults to a 2-hour lookback when no 'since' param is given, and rejects any caller-requested window wider than CloudTrailLookbackMax (7 days), because LookupEvents is heavily throttled and paginating a wide window in a busy account is both slow and memory-heavy.",
      "evidence": [
        {
          "resource": "repo://internal/actions/aws_cloudtrail.go#L17-L36",
          "version": "repo-lines-v1:sha256:76bfe11ffdc84b2e0d261806ea1bf9cb9325836ce008a48220359905aae36ac9:"
        }
      ]
    },
    {
      "id": "claim_9bc16a52f01a46a189b9a8fe4fe2d24e",
      "statement": "aws_route53.go's describeRecordSets requires a hosted zone ID as the target id because Route 53 has no call that lists records across zones, while describeHostedZones lists the account's zones with no id required since hosted zones are a global, account-wide resource.",
      "evidence": [
        {
          "resource": "repo://internal/actions/aws_get.go#L124-L134",
          "version": "repo-lines-v1:sha256:7ba4faecfd1b532bbade545afd2bfedc373c5529f51ca8689fb09d8e78da523e:"
