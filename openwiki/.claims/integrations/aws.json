  "claims": [
    {
      "id": "claim_42622c4473524507851ab176f51fae94",
      "statement": "Every AWS action implements actions.AWSAction, declaring RequiredServices(target AWSTarget) []awsapi.Service so AWSScope.Run builds only the AWS clients the action actually needs rather than every supported client.",
      "evidence": [
        {
          "resource": "repo://internal/actions/actions.go#L90-L97",
          "version": "repo-lines-v1:sha256:34a193c9b41e054bee5e837206c30c4bb4b3244684f5d2b281bf7c05d53a554e:"
        },
        {
