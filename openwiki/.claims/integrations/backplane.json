          "version": "repo-lines-v1:sha256:db056826cfeffad2407a149587777a20de2cb9ecbde21c93cbdb642dcce42fe3:"
        }
      ]
    },
    {
      "id": "claim_8fc056e511ab465cb5adb2026424c16b",
      "statement": "BackplaneProvider.requestAccess builds a CreateTrustedActionRequest from the caller's []RBACRule: rules with an empty Namespace become ClusterRoleRules, rules with a namespace are grouped per-namespace into sorted Roles, and CustomerDataAccess is always false; the request is authenticated with a bearer token obtained per-call from tokenFunc.",
