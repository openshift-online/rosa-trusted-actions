    {
      "id": "claim_6ef49089f80240d3ad39a61a413f800b",
      "statement": "KubeScope.Run requests a backplane session scoped to exactly the RequiredRBAC(target) rules for each primitive action execution via GetClient, rather than reusing one broad session; GetPodExecutor is called with the same rbacRules only when action.UsesPodExec() returns true, and the resulting PodExecutor is attached to actions.KubeClients only in that case.",
      "evidence": [
        {
          "resource": "repo://internal/executor/kube.go#L83-L101",
          "version": "repo-lines-v1:sha256:5d68d38af562834be5bc7436996db9e91a53ad76b9652c00176259c0f9486e99:"
        }
      ]
    },
    {
      "id": "claim_a836aa29b1024d06b6b062d0688eaa36",
      "statement": "BackplaneProvider.requestAccessAndConfig pins the origin of the backplane-returned proxy URI: it resolves ProxyUri against the configured base backplane URL and requires the resolved scheme and host to exactly match the base URL's, refusing to build a client if they differ; the resulting rest.Config's transport (bearerTransport) attaches the bearer token only to requests whose host matches the pinned trustedHost (or has no host), preventing the trusted-action token from being sent to an unverified origin.",
      "evidence": [
        {
          "resource": "repo://internal/backplane/client.go#L194-L210",
          "version": "repo-lines-v1:sha256:d3b721a3397c2dfee10fb435a9b4eda864b286ad09eef37f0fbbd9a83839e06c:"
