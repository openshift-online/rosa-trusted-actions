    {
      "id": "claim_16c1c1cfc6ea4025bacf9ddc7c3aa7d6",
      "statement": "itest-run.sh submits an aws-get request with a parameter the target resource does not accept and asserts the resulting execution status is 'failed', verifying that input validation survives the full HTTP execution path rather than only being covered by unit tests.",
      "evidence": [
