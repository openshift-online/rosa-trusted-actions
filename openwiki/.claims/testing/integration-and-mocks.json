    {
      "id": "claim_07f012d1468c4ccbba3006e01cce9dd7",
      "statement": "tests/mock-backplane's cluster fixture and action store use composite keys ({clusterId}:{kubernetes path} for the fixture, {clusterId}:{instanceId} for actions), which gives cross-cluster isolation between preloaded clusters automatically, with no cluster-specific code required.",
