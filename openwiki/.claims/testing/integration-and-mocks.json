    {
      "id": "claim_06b43476a18f43d887f69bdb5128ddae",
      "statement": "itest-run.sh exercises kube-api actions (get, describe-nodes, get-pull-secret-email, list-alerts) against fixtures applied by itest-up.sh, and aws-api actions (aws-get) against LocalStack, seeding EC2 instances, DHCP option sets, and Route53 hosted zones as needed, then polls GET /runs/{id} until a terminal status and asserts response content, not just status.",
      "evidence": [
        {
          "resource": "repo://integration/itest-run.sh#L169-L335",
          "version": "repo-lines-v1:sha256:30e844ff155ed7df4d95d307cf53c0f291df5a9bbad38056224a2d8168860113:"
        }
