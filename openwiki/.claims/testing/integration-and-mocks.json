    {
      "id": "claim_009e69e61d074b6a88f3e422e2f2bb3f",
      "statement": "tests/mock-backplane's RBAC matcher reproduces Kubernetes RBAC semantics (wildcards, empty-string core API group, resourceNames narrowing, clusterRoleRules required for cluster-scoped/all-namespace reads) but deliberately returns distinct status codes for different gaps: 501 for a path with no fixture entry or an unmodelled subresource/non-resource URL, 404 for a fixture entry explicitly marked absent, and 403 for a request the submitted RBAC never granted, and ignores selectors while logging a warning rather than silently filtering.",
      "evidence": [
        {
          "resource": "repo://tests/mock-backplane/README.md#L85-L191",
          "version": "repo-lines-v1:sha256:085e94900b31439c230c6e4eca53eec347c3078822968b357da9a708d22cddda:"
        }
      ]
    },
    {
      "id": "claim_72e19d93bde44cd2aa98df3c6a1aa604",
      "statement": "tests/mock-backplane intentionally deviates from the real Backplane contract in three ways: it returns a 24-hour token expiry versus the real contract's 720 minutes (unenforced so harmless), its FORBIDDEN_POLICIES list in scripts/trustedactions-post.js is a hand-copy of Backplane's unpublished validation rules that can silently drift, and its vendored backplane.yaml spec has no automated check against the upstream client spec for divergence.",
      "evidence": [
        {
          "resource": "repo://tests/mock-backplane/README.md#L193-L212",
          "version": "repo-lines-v1:sha256:b200a155f20f59da8d317bdd13289a202ab3245ad1bff57eba15f0be8ed90853:"
        }
      ]
    },
    {
      "id": "claim_9995964bc18f4bb7a44d1dc94fc9c632",
      "statement": "tests/proxy-backplane is a real Go reverse-proxy server that registers a trusted action by accepting a base64-encoded kubeconfig, parses its TLS credentials and bearer token into an in-memory store, and forwards any HTTP method on the proxy path to the live upstream cluster with the bearer token injected, making it suitable for exercising real Kubernetes write operations that the fixture-based mock cannot model.",
