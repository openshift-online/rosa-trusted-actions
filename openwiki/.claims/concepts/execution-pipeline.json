        },
        {
          "resource": "repo://internal/worker/executor_runner.go#L41-L81",
          "version": "repo-lines-v1:sha256:f377c7fe54e0ab39888e6e4905c9e737c229d8293736b199261eb1ea4108600e:"
        }
      ]
    }
