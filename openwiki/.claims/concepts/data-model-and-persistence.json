    {
      "id": "claim_bcc3b2d0b45d4a9f9bbe3246a56f93fe",
      "statement": "store.New selects the persistence backend purely by inspecting the DATABASE_URL scheme: a value prefixed with \"postgres://\" or \"postgresql://\" opens a PostgresStore, while any other value (including an empty string) falls back to SQLiteStore.",
      "evidence": [
        {
          "resource": "repo://internal/store/store.go#L57-L65",
          "version": "repo-lines-v1:sha256:345e8051f171cef0a4564722d96853a411af5cf69cd6bb167f37910db2b54e7e:"
        }
      ]
    },
    {
      "id": "claim_73f4edee882e4e17a6eda3c818005ca2",
      "statement": "The store.Store interface (CreateExecution, GetExecution, GetExecutionOutput, ListExecutions, UpdateExecutionWithResult, ClaimNextExecution, CreateAuditEntry, ListAuditEntries, Close) is the single persistence abstraction implemented identically in behavior by both PostgresStore and SQLiteStore, with ErrNotFound as the shared not-found sentinel.",
      "evidence": [
