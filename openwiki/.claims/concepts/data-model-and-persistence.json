    {
      "id": "claim_08dd68769d3d47a085495de0b1869c65",
      "statement": "internal/store/shared.go centralizes the executionColumns, outputColumns, and auditColumns column lists used identically by both PostgresStore and SQLiteStore for SELECT/INSERT statements; their order must match the corresponding *Row struct field order because sqlx StructScan binds columns positionally.",
      "evidence": [
        {
          "resource": "repo://internal/store/shared.go#L1-L14",
          "version": "repo-lines-v1:sha256:66bb929ae654baf72531715e9ede9aec76f162fe4ca68390d4857e845c80d9ca:"
