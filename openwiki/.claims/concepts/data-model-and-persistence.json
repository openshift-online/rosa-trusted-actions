        }
      ]
    },
    {
      "id": "claim_9303897801ff484bafe5754f89958383",
      "statement": "SQLiteStore formats all timestamps with the fixed-width layout \"2006-01-02T15:04:05.000000000Z07:00\" (timeLayout) before storing them as TEXT, so that lexical string comparisons used for ordering and range filters sort identically to chronological order; PostgresStore instead stores timestamps natively as TIMESTAMPTZ.",
