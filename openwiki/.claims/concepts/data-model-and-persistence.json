    {
      "id": "claim_24d96e1a4c544123bfea8dc8471ca047",
      "statement": "buildExecutionWhere and buildAuditWhere in shared.go build the common WHERE-clause fragments shared by both backends using \"?\" placeholders, which PostgresStore rebinds to \"$1, $2, ...\" via db.Rebind while SQLiteStore uses them unchanged; both helpers intentionally exclude the Since filter because timestamp representation differs (native time.Time/TIMESTAMPTZ for Postgres vs. fixed-width TEXT for SQLite), so each store appends its own Since clause with backend-appropriate formatting after calling the shared builder.",
      "evidence": [
        {
          "resource": "repo://internal/store/postgres.go#L141-L146",
          "version": "repo-lines-v1:sha256:2eaf961301b1200966855a85aff846106364eaf619f2979bd9b5dd4e64ad10d4:"
