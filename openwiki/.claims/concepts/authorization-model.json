        },
        {
          "resource": "repo://internal/auth/authz_mock.go#L1-L29",
          "version": "repo-lines-v1:sha256:a507f02c0f9489513537bc64728235c027ae5ced1c76f5532f68d91065c759c2:"
        }
      ]
    },
    {
      "id": "claim_1010744868984a8aaf74c3c2ad968176",
      "statement": "When ROSA_TA_AUTH=disabled, cmd/server/main.go enforces two startup safety guards and calls logger.Fatal if either is unmet: cfg.Kubeconfig (ROSA_TA_KUBECONFIG) must be set so the mock identity cannot reach the real backplane, and cfg.AWSEndpointURL (ROSA_TA_AWS_ENDPOINT_URL) must be set so mock auth cannot reach real AWS via ambient SDK credentials.",
      "evidence": [
        {
          "resource": "repo://cmd/server/main.go#L184-L200",
          "version": "repo-lines-v1:sha256:31a3d876ebd155ba9a39f8d79fd7f875de55233cd0de1938f0bbd114adef1c93:"
