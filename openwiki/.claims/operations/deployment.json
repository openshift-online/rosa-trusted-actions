    {
      "id": "claim_a4976feaad374ef78e05aba3e70c2a8f",
      "statement": "The regional Terraform root reads IAM role ARNs and the Secrets Manager secret ARN from the global workspace's state via a terraform_remote_state data source (aliased to local.global), rather than receiving them as plain variables; this requires the global workspace to already have state and to share it with the regional workspace.",
      "evidence": [
        {
          "resource": "repo://terraform/regional/remote_state.tf",
          "version": "repo-file-v1:sha256:97a83ef3c4e3896719232c1c04505c0741cf2004a6a83bfecc56bbac50e8f625"
        }
      ]
    },
    {
      "id": "claim_774d16ddd2d64265acfc5bac177af4d3",
      "statement": "The S3 bucket is created in the regional Terraform root (not global); s3_bucket_name_suffix must be identical in both roots so the global workspace's IAM wildcard ARN (ACCOUNT-ENVIRONMENT-SUFFIX-*) covers the bucket each region creates.",
      "evidence": [
        {
          "resource": "repo://terraform/global/outputs.tf",
          "version": "repo-file-v1:sha256:5cd180c982168387e42b6b8d682893482a98895696aaa906add1ae329522c524"
        },
        {
