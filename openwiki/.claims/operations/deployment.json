          "version": "repo-lines-v1:sha256:deb616578f8257884560b80ba140bb838175284128c5a6e098d87b88b1bab3cc:"
        }
      ]
    },
    {
      "id": "claim_5b87433e7ba04704b2041d125e5222aa",
      "statement": "Because terraform/global exposes IAM with wildcard resource ARNs rather than per-region ARNs, adding a new AWS region only requires changes in terraform/regional plus a new HCP Terraform workspace; terraform/global is never re-applied for a new region.",
      "evidence": [
        {
          "resource": "repo://docs/deployment.md#L313-L330",
          "version": "repo-lines-v1:sha256:57f9bde84eea6afee32221f21dccd860fe5c9d842a093b654bb513a04b23ff6b:"
