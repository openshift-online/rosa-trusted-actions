    {
      "id": "claim_390b0cae2c694442a28492638fb64584",
      "statement": "For local CLI testing without HCP Terraform, a gitignored terraform/regional/local_override.tf (an _override.tf file that Terraform merges last and that fully replaces a same-named data block) swaps the regional root's terraform_remote_state backend from \"remote\" to \"local\", pointing at ../global/terraform.tfstate, so a locally-applied global root can be consumed by a locally-applied regional root without modifying any committed source file.",
      "evidence": [
        {
          "resource": "repo://docs/deployment.md#L153-L272",
          "version": "repo-lines-v1:sha256:db56714ea6bc9c5355c14729344ab1c4b786cf12ee510839d1665e749a18ed8b:"
