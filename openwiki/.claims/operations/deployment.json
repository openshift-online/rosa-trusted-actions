          "version": "repo-lines-v1:sha256:48bbef5ee7ab37db0ea1f2cae0ce9b94960b9ef2f1edc4abeefe635b2ef11364:"
        }
      ]
    },
    {
      "id": "claim_a456ab08e69a4b22b4f34ce255b2f463",
      "statement": "Both HCP Terraform workspaces (rosa-trusted-actions-global and rosa-trusted-actions-stage) set auto_apply = true and auto_apply_run_trigger = true, so plans apply automatically with no manual confirmation step, whether queued directly or by the cross-workspace run trigger; both also attach to the rosa-trusted-actions-rosa-boundary-stage-rosa-trusted-actions-aws-dynamic-creds variable set for AWS credentials, and s3_bucket_name_suffix / internal_fqdn must match between the global and regional workspace variables for a given deployment.",
      "evidence": [
        {
          "resource": "repo://hcp-terraform/rosa-trusted-actions/main.tf#L108-L182",
          "version": "repo-lines-v1:sha256:30592a7b2541448d20b365f099e932bb8304774e476774378bb778c8fb22f8a6:"
