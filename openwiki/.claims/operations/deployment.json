    {
      "id": "claim_3fc7defeac204bd2ab4ce79a8ff59aa2",
      "statement": "IAM role ARNs and the Secrets Manager ARN are deliberately not declared as regional HCP Terraform workspace variables; they are obtained exclusively through terraform_remote_state from the global workspace.",
