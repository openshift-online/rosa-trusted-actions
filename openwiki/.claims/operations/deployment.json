  "claims": [
    {
      "id": "claim_1d8364d1335a46a7a099a6a658f69586",
      "statement": "terraform/global is applied once per AWS account and owns IAM roles/policies, the Secrets Manager app secret, and the ACM DNS-01 validation CNAME, while terraform/regional is applied once per AWS region and owns VPC, ALB, ECS (EC2 host + EBS), S3 bucket, CloudWatch→Firehose audit logging, Route 53 Private Hosted Zone, and the regional ACM certificate.",
      "evidence": [
        {
          "resource": "repo://docs/deployment.md#L5-L16",
          "version": "repo-lines-v1:sha256:6c9b2ac5a4e25f9ae798cf7fcc1cf60c390f6bb38bcc793d12cde9955fb90834:"
        },
        {
