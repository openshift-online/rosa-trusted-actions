        },
        {
          "resource": "repo://terraform/regional/acm.tf",
          "version": "repo-file-v1:sha256:84dfcf27cf394c079ade7859734be4c3c098100282898fcde1f263df044e6ae4"
        },
        {
          "resource": "repo://terraform/regional/route53-private.tf",
          "version": "repo-file-v1:sha256:0bdf4949b57f84f3f9f46175462f86a3d8241a5d54b8863d1987992b5ec7c8f1"
        }
