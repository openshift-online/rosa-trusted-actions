        }
      ]
    },
    {
      "id": "claim_33d1b1b4b06e41ccaac58ae1a6679e56",
      "statement": "HCP Terraform workspaces for this service are declared in hcp-terraform/rosa-trusted-actions/main.tf via the hashicorp/tfe provider and a shared workspaces module; the regional workspace (rosa-trusted-actions-stage) declares source_workspaces = [\"rosa-trusted-actions-global\"], which creates an automatic run trigger so a regional run queues after a successful global apply, and the global workspace declares remote_state_consumer_workspaces = [\"rosa-trusted-actions-stage\"] to grant state-read access.",
      "evidence": [
        {
          "resource": "repo://hcp-terraform/rosa-trusted-actions/main.tf",
          "version": "repo-file-v1:sha256:f31b2abcbf4cbcab0f033054620d4a977a3b0452145c1b67e7cbfed27d369a81"
        },
        {
