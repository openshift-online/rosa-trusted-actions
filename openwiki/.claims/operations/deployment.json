        }
      ]
    },
    {
      "id": "claim_9d3239ce2f794ea6b417c6d38845bf46",
      "statement": ".tekton/rosa-trusted-actions-pull-request.yaml runs on pull_request events targeting main and .tekton/rosa-trusted-actions-push.yaml runs on push events targeting main; both build the container image from Containerfile using a shared buildah-based, trusted-artifacts multi-platform pipeline (init, clone-repository, prefetch-dependencies, build-images matrix task per platform, build-image-index, build-source-image, deprecated-base-image-check, image checks including roxctl-scan/ecosystem-cert-preflight-checks/sast-snyk-check/clamav-scan/sast-shell-check/sast-unicode-check/rpms-signature-scan, apply-tags, push-dockerfile), with the push pipeline publishing to quay.io/redhat-user-workloads/rosa-tenant/rosa-trusted-actions:{{revision}}.",
      "evidence": [
        {
          "resource": "repo://.tekton/rosa-trusted-actions-pull-request.yaml#L11-L11",
          "version": "repo-lines-v1:sha256:7576e743d9838c22d7f4857df00d691d7dab2ff86298d1345fbd46b9aecc684b:"
