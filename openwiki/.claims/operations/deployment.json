    },
    {
      "id": "claim_a8fa3c8c9c95424a82aca40292615c40",
      "statement": "The current rosa-trusted-actions-global HCP Terraform workspace definition does not set public_zone_id (it is left as a commented-out template), so the gated ACM validation CNAME/validation-anchor certificate in terraform/global/dns.tf and the gated regional certificate/HTTPS listener in terraform/regional/acm.tf are currently inert and the ALB serves HTTP only, until an operator supplies a real public_zone_id value.",
      "evidence": [
        {
          "resource": "repo://hcp-terraform/rosa-trusted-actions/main.tf#L99-L105",
          "version": "repo-lines-v1:sha256:d8fa8ce1d88357bb9108347553c5e364292ac4e8f46abe02d859a86bdfe4d499:"
