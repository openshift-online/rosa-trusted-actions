        }
      ]
    },
    {
      "id": "claim_1e24a20d6e18437f9f102c46769fb851",
      "statement": "A regional HTTPS ALB listener and regional ACM certificate are only created when both internal_fqdn and public_zone_id are set (local.https_enabled); otherwise the ALB serves HTTP only, and an operator can alternatively bypass ACM entirely by supplying alb_certificate_arn for a certificate managed outside Terraform.",
      "evidence": [
        {
          "resource": "repo://terraform/regional/acm.tf#L36-L43",
          "version": "repo-lines-v1:sha256:f5eb1ee601bb100cb77d315004d41aad4ddff9604f61eb39e209cf4c09b240b9:"
