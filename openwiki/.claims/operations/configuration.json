          "version": "repo-lines-v1:sha256:ff164bd460036ee4671261ef57035bafb23aecd51c07f03947daf4d847dbab74:"
        }
      ]
    },
    {
      "id": "claim_5e63ebe942c74943bab425dbdce27b87",
      "statement": "roles: is a config-file-only setting with no environment variable equivalent; the previously supported ROSA_TA_ROLES_CONFIG environment variable is no longer read by config.Load and setting it only prints a startup warning.",
