    },
    {
      "id": "claim_f33221950fda4c089da1ba20a17831e4",
      "statement": "The YAML config file (parsed by readConfigFile in internal/config/config.go) supports workers.{concurrency,poll_interval,execution_timeout} and actions.{allowed_namespaces,allowed_secrets,aws_allowed_regions,aws_allowed_operations}, plus aws.{endpoint_url,proxy_url}, backplane.{assume_initial_arn,proxy_url}, and roles; readConfigFile seeds workers defaults (4 / 5s / 2m) before parsing so they apply even when the workers key or the file itself is absent, and every config-file key except roles is overridden by a corresponding environment variable when that variable is set.",
      "evidence": [
        {
          "resource": "repo://config/config.yaml",
          "version": "repo-file-v1:sha256:76fa934ecd12251565c8b74958247672f68ce02e3faaa8bdba2088071278df9f"
        },
