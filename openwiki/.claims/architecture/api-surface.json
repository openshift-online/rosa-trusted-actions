    {
      "id": "claim_90087a1708274f039807decaa3e3cfeb",
      "statement": "POST /{action}/run (CreateExecution) validates the action exists, decodes ExecutionRequest, persists a pending models.Execution via store.Store.CreateExecution, calls ExecutionNotifier.Notify() to wake the worker pool immediately, attaches execution details to the request's audit context, and responds 202 Accepted with a self HAL link to GET /runs/{id}; the actual run happens asynchronously in a background worker.",
      "evidence": [
        {
          "resource": "repo://internal/handlers/api.go#L87-L142",
          "version": "repo-lines-v1:sha256:f389c59320278e37643dbc04fdd5a7f6ad34c826815a555a4e7bdc89659e3f09:"
