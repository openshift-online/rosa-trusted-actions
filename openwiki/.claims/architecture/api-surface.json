    {
      "id": "claim_3f34b5c242ac47eabf475071dfb856f8",
      "statement": "internal/openapi/api.go is machine-generated by oapi-codegen (header states 'DO NOT EDIT') and defines the request/response types, enum Valid() helpers, the ServerInterface (one method per operationId), and HandlerWithOptions which mounts all operations as chi routes with support for injected MiddlewareFunc.",
      "evidence": [
        {
          "resource": "repo://internal/openapi/api.go#L1-L16",
          "version": "repo-lines-v1:sha256:ad587c71e609799e5b0137ace5641b369e3a9a064d870f615e3491140c5bd6fb:"
        }
      ]
    },
    {
      "id": "claim_8c555cafa0854a77af6843b2edddb49e",
      "statement": "internal/handlers/api.go defines APIHandler, which implements openapi.ServerInterface (enforced via a compile-time assertion) and holds the logger, catalog.Catalog, store.Store, and an ExecutionNotifier used to wake the worker pool immediately after an execution is queued.",
      "evidence": [
        {
          "resource": "repo://internal/handlers/api.go#L25-L54",
