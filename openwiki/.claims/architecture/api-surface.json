    {
      "id": "claim_6696375e10e5406590f014416a8b304f",
      "statement": "The HTTP API is defined OpenAPI-first in openapi/: openapi.yaml is the entrypoint referencing per-path files in openapi/paths/ (using an '@' separator for nested/parameterized segments) and schemas in openapi/components/schemas/, following the conventions described in openapi/README.md and openapi/paths/README.md.",
      "evidence": [
        {
          "resource": "repo://openapi/README.md",
          "version": "repo-file-v1:sha256:e276178c246895a32ec744a0f983101a1db0652243ad857060b3175bb5a55094"
        },
