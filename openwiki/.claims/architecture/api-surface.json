    {
      "id": "claim_298006ef2f044b9db7a18f32ee6f3925",
      "statement": "middleware.Recoverer recovers from panics anywhere downstream in the router chain, logs the panic value/stack/request metadata, and responds with a plain-text 500 via http.Error rather than the structured Error JSON body used elsewhere.",
