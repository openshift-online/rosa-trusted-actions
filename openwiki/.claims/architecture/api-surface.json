    },
    {
      "id": "claim_f7b337320e69476f9494fa4b35253ba5",
      "statement": "The build bundles the multi-file OpenAPI spec into a single api-spec.yaml (make bundle-spec / npm run bundle-spec) and then runs oapi-codegen against it using oapi-codegen.yaml to generate internal/openapi/api.go (make generate-api); make generate runs both steps and is a prerequisite of build/run/test targets, and make validate-spec separately lints the spec.",
      "evidence": [
        {
          "resource": "repo://Makefile#L47-L64",
          "version": "repo-lines-v1:sha256:8da98c1a85d338eef5b5bf0f43167462996fdf196892efa238222097a81db3bf:"
