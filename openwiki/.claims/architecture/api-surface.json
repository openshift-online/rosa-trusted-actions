    {
      "id": "claim_34c7b11194d247d9aa7e9fef045c1b40",
      "statement": "GET / (Catalog) and GET /{action} (Describe) are declared security: [] in the OpenAPI spec, marking them as intentionally public discovery endpoints, but cmd/server/main.go mounts JWT authentication on the whole /api/v0/trusted-actions chi sub-tree before openapi.HandlerWithOptions is reached, so this per-operation override is not currently enforced; a TODO in main.go flags this as a known gap the CLI needs resolved.",
      "evidence": [
        {
          "resource": "repo://cmd/server/main.go#L374-L390",
          "version": "repo-lines-v1:sha256:45c599fb72055e701a6ada953f43a95b1bfa3618101b8d22fd95a88ca12cdcc3:"
