    {
      "id": "claim_c16ed836da6d43918c3e8d5d4c119e12",
      "statement": "GetExecution attaches a self HAL link always, and an output HAL link to GET /runs/{exec_id}/output only when store.Store.GetExecutionOutput succeeds for that execution id, so the link is computed per request rather than being a static property of the stored execution.",
      "evidence": [
