{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openshift/boilerplate//.github/renovate.json"
  ],
  "dockerfile": {
    "includePaths": [
      "Containerfile"
    ],
    "packageRules": [
      {
        "description": "Review Hummingbird runtime digest updates before merging",
        "matchPackageNames": [
          "registry.access.redhat.com/hi/core-runtime"
        ],
        "matchUpdateTypes": [
          "digest"
        ],
        "automerge": false,
        "platformAutomerge": false
      }
    ]
  },
  "ignoreDeps": [
    "github.com/dprotaso/go-yit"
  ]
}
