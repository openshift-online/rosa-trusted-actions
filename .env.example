# ROSA Trusted Actions Server Configuration
# Copy this file to .env and customize the values

# AWS Configuration (required for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-session-token  # Optional, for temporary credentials

# Storage Configuration
ROSA_TA_S3_BUCKET=trusted-actions-bucket
ROSA_TA_S3_KEY_PREFIX=trusted-actions

# Security Configuration
ROSA_TA_ALLOWED_ACCOUNTS=123456789012,987654321098

# Database Configuration
# For local development, start Postgres with: make postgres-up
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trusted_actions?sslmode=disable

# Backplane Configuration (production cluster access)
ROSA_TA_BACKPLANE_URL=https://backplane.example.com
ROSA_TA_BACKPLANE_CLIENT_ID=trusted-actions
ROSA_TA_BACKPLANE_CLIENT_SECRET=secret

# Kubernetes Configuration (local testing only, overrides backplane)
# ROSA_TA_KUBECONFIG=~/.kube/config

# Workers Configuration
# (those env settings take precedence over the main configuration file)
ROSA_TA_WORKER_CONCURRENCY=4
ROSA_TA_WORKER_POLL_INTERVAL=5s
ROSA_TA_WORKER_EXECUTION_TIMEOUT=2m

# Actions Configuration
# (those env settings take precedence over the main configuration file)
ROSA_TA_ALLOWED_NAMESPACES=openshift-logging,openshift-monitoring,openshift-operators
ROSA_TA_ALLOWED_SECRETS=openshift-logging/collector-config,openshift-monitoring/alertmanager-config

# Optional
ROSA_TA_JWK_CERT_FILE=""
ROSA_TA_JWK_CERT_URL="https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/certs"
ROSA_TA_OCM_BASE_URL="https://api.openshift.com"
ROSA_TA_OCM_CLIENT_ID=""
ROSA_TA_OCM_CLIENT_SECRET=""
ROSA_TA_OCM_TOKEN=""

# Optional: define server settings via environment
# (CLI flags take precedence over these)
ROSA_TA_LISTEN_ADDR=:8080
ROSA_TA_LOG_LEVEL=info
ROSA_TA_LOG_JSON=false

# --- AWS policy -------------------------------------------------------------
# Which AWS regions actions may read from. REQUIRED when AWS actions are in
# use: there is no built-in default, and the server exits at startup without
# one. Comma-separated. action-cli reads the same variable.
ROSA_TA_AWS_ALLOWED_REGIONS=us-east-1

# Which AWS mutations are permitted: reboot, terminate. Empty (the default)
# permits no writes at all while still permitting every read. Naming an
# operation here is how a deployment acquires the ability to change a
# cluster's cloud infrastructure.
ROSA_TA_AWS_ALLOWED_OPERATIONS=

# --- AWS connection ---------------------------------------------------------
# Points AWS traffic at a local emulator (LocalStack). Setting it also selects
# the static client provider over the backplane one, so every cluster resolves
# to one account. Leave unset in any deployment that talks to real AWS.
ROSA_TA_AWS_ENDPOINT_URL=

# Proxy for AWS traffic. Empty falls back to ROSA_TA_BACKPLANE_PROXY_URL,
# matching backplane-cli.
ROSA_TA_AWS_PROXY_URL=

# Credentials for the static provider only. The production path gets
# short-lived STS credentials from backplane instead and ignores these.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Backplane (AWS credential chain) ---------------------------------------
# The payer-account role the assume-role chain starts from. Normally left
# empty: backplane-cli infers it from the OCM URL and rejects anything that is
# not one of the three known SRE support roles.
ROSA_TA_BACKPLANE_ASSUME_INITIAL_ARN=

# Proxy used to reach the backplane API.
ROSA_TA_BACKPLANE_PROXY_URL=
